# i番目（0-index）の要素を取得。負の index は末尾からの指定。
# print(tree[3])
# print(tree.get(3))  # 上と同じ

# i番目（0-index）の要素を100に更新
# tree[3] = 100
# tree.set(3, 100)  # 上と同じ

# pos の位置（0-index）に value を挿入。
# 既存の pos 番目以降は 1 つ後ろにずれる。
# pos == len(tree) なら末尾に追加される。
# tree.insert(pos, value)

