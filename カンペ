#回文数生成
def gen_palindromes(n):
    # 桁数ごと
    d = 1
    while True:
        half_len = (d + 1) // 2
        start = 10 ** (half_len - 1) if d > 1 else 1
        end = 10 ** half_len

        for x in range(start, end):
            # 回文生成
            res = x
            t = x if d % 2 == 0 else x // 10
            while t:
                res = res * 10 + t % 10
                t //= 10

            if res > n:
                return
            yield res

        d += 1
#回文数生成　使用方法
