# ========================================
# 文字列：Z-algorithm
# ========================================
def z_algorithm(s):
    n = len(s)
    z = [0] * n
    z[0] = n
    l = r = 0

    for i in range(1, n):
        if i < r:
            z[i] = min(r - i, z[i - l])

        while i + z[i] < n and s[z[i]] == s[i + z[i]]:
            z[i] += 1

        if i + z[i] > r:
            l = i
            r = i + z[i]

    return z

# z[i] = sとs[i:]の最長共通接頭辞の長さ
# O(len(s))


