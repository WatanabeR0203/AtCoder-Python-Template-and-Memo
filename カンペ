# ========================================
# 双方向連結リスト（配列実装）
# ========================================
# prev[i] : i の左
# next[i] : i の右
# -1 は存在しない
N = 10
prev = [-1] * N
next = [-1] * N
for i in range(N):
    if i > 0:
        prev[i] = i - 1
    if i < N - 1:
        next[i] = i + 1
# i を削除
def erase(i):
    l = prev[i]
    r = next[i]
    if l != -1:
        next[l] = r
    if r != -1:
        prev[r] = l
# ========================================
# add_right
# i の右に x を挿入
# ========================================
def add_right(i, x):
    r = next[i]
    prev[x] = i
    next[x] = r
    next[i] = x
    if r != -1:
        prev[r] = x
# ========================================
# add_left
# i の左に x を挿入
# ========================================
def add_left(i, x):
    l = prev[i]
    next[x] = i
    prev[x] = l
    prev[i] = x
    if l != -1:
        next[l] = x
# ========================================
# 使用例
# ========================================
