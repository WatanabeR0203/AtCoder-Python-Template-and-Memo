from collections import deque

# G[u] = uから出る辺の行き先
indeg = [0] * N
for u in range(N):
    for v in G[u]:
        indeg[v] += 1

q = deque(v for v in range(N) if indeg[v] == 0)
order = []

while q:
    v = q.popleft()
    order.append(v)

    for to in G[v]:
        indeg[to] -= 1
        if indeg[to] == 0:
            q.append(to)

# len(order) == N ならDAG
# len(order) < N なら有向閉路あり
