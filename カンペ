# ========================================
# グラフ：SCC（強連結成分分解、反復Kosaraju法）
# ========================================
# G[u] = uから出る辺の行き先
# RG[v] = vに入る辺を逆向きにしたグラフ
RG = [[] for _ in range(N)]
for u in range(N):
    for v in G[u]:
        RG[v].append(u)

# 1回目：DFSの帰りがけ順
seen = [False] * N
order = []

for s in range(N):
    if seen[s]:
        continue

    seen[s] = True
    stack = [(s, 0)]

    while stack:
        v, i = stack[-1]

        if i == len(G[v]):
            order.append(v)
            stack.pop()
            continue

        to = G[v][i]
        stack[-1] = (v, i + 1)

        if not seen[to]:
            seen[to] = True
            stack.append((to, 0))

# 2回目：逆グラフで成分を割り当てる
comp = [-1] * N
C = 0

for s in reversed(order):
    if comp[s] != -1:
        continue

    comp[s] = C
    stack = [s]

    while stack:
        v = stack.pop()

        for to in RG[v]:
            if comp[to] == -1:
                comp[to] = C
                stack.append(to)

    C += 1

# comp[v] = 頂点vのSCC番号
# C = SCCの個数
# SCC番号はトポロジカル順に割り当てられる
# 同じSCCか：comp[u] == comp[v]


