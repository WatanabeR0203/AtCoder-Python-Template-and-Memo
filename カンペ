# ========================================
# 数学：最小素因数（SPF）による素因数分解
# ========================================
# 1以上MAX以下の整数を素因数分解
MAX = 10**6
spf = list(range(MAX + 1))

for i in range(2, int(MAX**0.5) + 1):
    if spf[i] == i:
        for j in range(i * i, MAX + 1, i):
            if spf[j] == j:
                spf[j] = i

def factorize(n):
    res = []
    while n > 1:
        p = spf[n]
        cnt = 0
        while n % p == 0:
            n //= p
            cnt += 1
        res.append((p, cnt))
    return res

