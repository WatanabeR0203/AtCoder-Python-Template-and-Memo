# MOD Combination
# nCr % MOD nデカい版
# ========================================
MOD = 998244353
MAX = 2 * 10**6 + 5

fact = [1] * MAX
inv_fact = [1] * MAX
# 階乗
for i in range(1, MAX):
    fact[i] = fact[i - 1] * i % MOD
# 逆元階乗
inv_fact[-1] = pow(fact[-1], MOD - 2, MOD)
for i in range(MAX - 1, 0, -1):
    inv_fact[i - 1] = inv_fact[i] * i % MOD
# nCr
def comb(n, r):
    if r < 0 or r > n:
        return 0
    return (
        fact[n]
        * inv_fact[r]
        % MOD
        * inv_fact[n - r]
        % MOD
    )
# ========================================
n小さい版
# ========================================
MOD = 998244353
MAXR = 10**6 + 5
fact = [1] * MAXR
inv_fact = [1] * MAXR
for i in range(1, MAXR):
    fact[i] = fact[i - 1] * i % MOD
inv_fact[-1] = pow(fact[-1], MOD - 2, MOD)
for i in range(MAXR - 1, 0, -1):
    inv_fact[i - 1] = inv_fact[i] * i % MOD
def comb_large_n(n, r):
    if r < 0 or r > n:
        return 0
    num = 1
    for i in range(r):
        num = num * ((n - i) % MOD) % MOD
    return num * inv_fact[r] % MOD



